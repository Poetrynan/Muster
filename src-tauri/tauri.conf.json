{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muster",
  "version": "0.1.12",
  "identifier": "com.poetrynan.muster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Muster",
        "width": 1360,
        "height": 840,
        "minWidth": 960,
        "minHeight": 540,
        "backgroundColor": "#FFFFFF",
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Poetrynan/Muster/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQwMjg2QTM0QTFGOUM4MTEKUldRUnlQbWhOR29vMEttdC9pQ0VjclErSUN4Tkx1cWkzakpMVk11ZmVOa1ZKSlBiejRMTGVDcTQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
